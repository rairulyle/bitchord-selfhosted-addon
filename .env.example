# Required
PLEX_URL=http://plex:32400
PLEX_TOKEN=
# At least 16 characters of letters, digits, '-' or '_'. Generate one with: openssl rand -hex 24
ADDON_SECRET=
# The HTTPS origin your reverse proxy serves this addon on, without a path
PUBLIC_URL=https://music.example.com

# Optional
# PLEX_SECTION=Music
# REFRESH_INTERVAL=15m
# ADDON_NAME=Plex
# PORT=8080
# LOG_LEVEL=info
# LOG_FORMAT=text
