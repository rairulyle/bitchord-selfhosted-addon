# Fill in ONE server set, Plex or Jellyfin. Filling in both is an error.

# Plex
PLEX_URL=http://plex:32400
PLEX_TOKEN=
# PLEX_SECTION=Music

# Jellyfin, 10.9 or newer
# JELLYFIN_URL=http://jellyfin:8096
# JELLYFIN_API_KEY=
# JELLYFIN_LIBRARY=Music

# Required
# At least 16 characters of letters, digits, '-' or '_'. Generate one with: openssl rand -hex 24
ADDON_SECRET=
# The HTTPS origin your reverse proxy serves this addon on, without a path
PUBLIC_URL=https://music.example.com

# Optional
# REFRESH_INTERVAL=15m
# ADDON_NAME=Plex
# PORT=8080
# LOG_LEVEL=info
# LOG_FORMAT=text
